ARG UPSTREAM_IMAGE
FROM ${UPSTREAM_IMAGE}
ARG QUOTA_IMAGE_TAG
ENV VM2API_QUOTA_IMAGE_TAG=${QUOTA_IMAGE_TAG}
COPY src/lib/pool/credential-weight.mjs src/lib/pool/pool-scheduler.mjs /opt/vm2api/src/lib/pool/
COPY src/lib/admin/panel-api.mjs src/lib/admin/release.mjs /opt/vm2api/src/lib/admin/
COPY scripts/panel-upgrade.sh /opt/vm2api/scripts/
RUN rm -rf /opt/vm2api/web/dist
COPY web-dist/ /opt/vm2api/web/dist/
